# Copy this file to .env before running `docker compose up -d --build`.
# APP_KEY is generated automatically on first boot and written back here.

APP_NAME="FiveM-Catalog"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Ports exposed on the host machine. Bound to 127.0.0.1 by default so the
# app is never reachable directly (bypassing Caddy/HTTPS) in production; it's
# still reachable at http://localhost:8000 for local installs either way.
APP_PORT=127.0.0.1:8000
ADMINER_PORT=127.0.0.1:8081

# --- Production only (docker-compose.prod.yml) ---------------------------
# Required: your domain's DNS must already point at this server, with ports
# 80/443 open, before starting the stack — Caddy requests a Let's Encrypt
# certificate for APP_DOMAIN on first boot.
# Both required by docker-compose.prod.yml (Caddy refuses to start without them):
# APP_DOMAIN=fivem-catalog.com
# ACME_EMAIL=you@example.com
# Also set for production: APP_URL=https://fivem-catalog.com and
# SESSION_SECURE_COOKIE=true (see below)

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fivem_catalog
DB_USERNAME=fivem
DB_PASSWORD=fivem

# Set to true to seed demo data (an admin, a creator, and sample resources)
# on first boot. Ignored on every boot after the first.
DB_SEED=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS via Caddy) so session/CSRF cookies are
# never sent over plain HTTP. Keep false for local http://localhost installs.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
